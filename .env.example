# Copy this file to .env (repo root) and fill in your values.
# Never commit .env — it is git-ignored.

# PostgreSQL (matches docker-compose.yml; any hosted Postgres with pgvector also works, e.g. free Neon)
DATABASE_URL=postgresql://campusos:campusos@localhost:5433/campusos

# --- AI assistant (OpenRouter only) -------------------------------------------------
# Comma-separated keys from separate OpenRouter accounts. The gateway cycles through them,
# so the free-tier daily allowance multiplies by the number of keys.
# Get free keys at https://openrouter.ai/settings/keys
OPENROUTER_API_KEYS=sk-or-v1-key-one,sk-or-v1-key-two,sk-or-v1-key-three

# Ordered model chain: every healthy key is tried on the first model before moving to the next.
OPENROUTER_MODELS=z-ai/glm-5.2:free,minimax/minimax-m3:free,nvidia/nemotron-3.5-lightning:free

# Advisory free-tier budget per key (a real 429 from OpenRouter always wins).
OPENROUTER_RPD_PER_KEY=50
OPENROUTER_RPM_PER_KEY=20

# Agent runtime limits
AGENT_MAX_ITERATIONS=6
AGENT_TURN_BUDGET_S=45
AGENT_CALL_TIMEOUT_S=30
AGENT_MAX_CONCURRENT=8
AGENT_MAX_TOKENS=700
AGENT_HISTORY_TURNS=12
# Deployment-wide daily turn cap: protects the free quota on a public URL
AGENT_DAILY_CAP=800
# 1 = when every provider fails, answer read-only questions straight from live data
AGENT_DEGRADED_MODE=1

# 0 = disable local embeddings (hybrid search degrades to keyword-only)
EMBEDDINGS_ENABLED=1
TZ_NAME=Asia/Dhaka
PORT=8000
APP_URL=http://localhost:8000

# Extra CORS origins for a separately deployed frontend (comma-separated), e.g. your Vercel URL
# ALLOWED_ORIGINS=https://campusos.vercel.app
