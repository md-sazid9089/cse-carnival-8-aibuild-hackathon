# Copy this file to .env (repo root) or backend/.env and fill in your values
# Never commit your actual .env file

# PostgreSQL (matches docker-compose.yml; any hosted Postgres with pgvector also works, e.g. free Neon)
DATABASE_URL=postgresql://campusos:campusos@localhost:5433/campusos

# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_ROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# 1 = bypass multi-agent orchestration, run single-agent loop with all tools
FALLBACK_SINGLE_AGENT=0
# 0 = disable local embeddings (hybrid search degrades to keyword-only)
EMBEDDINGS_ENABLED=1
TZ_NAME=Asia/Dhaka
PORT=8000

# Extra CORS origins for a separately deployed frontend (comma-separated), e.g. your Vercel URL
# ALLOWED_ORIGINS=https://campusos.vercel.app
